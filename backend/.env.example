# Copy this file to .env and edit the values.

# REQUIRED — long random string used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the whole app (API + website) listens on.
# Use 80 to reach it directly via http://YOUR_VPS_IP/
PORT=3000
HOST=0.0.0.0

# Optional overrides
# DATA_DIR=/var/lib/hotwheels        # where the SQLite database lives
# UPLOAD_DIR=/var/lib/hotwheels/uploads
# FRONTEND_DIST=../frontend/dist
